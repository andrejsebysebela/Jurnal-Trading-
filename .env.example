# ─────────────────────────────────────────────────────────────────────────────
# EDGELOG environment variables. Copy to `.env.local` for local development.
# NEVER commit real values. NEVER add the Supabase service_role / secret key —
# the app does not use it, and anything prefixed NEXT_PUBLIC_ is sent to browsers.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL — local: http://127.0.0.1:54321 · production: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon / publishable key (public by design; protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key

# Canonical public URL of the app, no trailing slash. Used in auth emails (confirm, password reset).
# local: http://localhost:3000 · production: https://app.your-domain.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000
